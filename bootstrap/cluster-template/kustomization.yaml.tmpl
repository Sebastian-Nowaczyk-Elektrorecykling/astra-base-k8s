apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
- ../base
- flux-system
- dns-forwarding.yaml
patches:
- path: settings.yaml
replacements:
- source:
    kind: ConfigMap
    name: cluster-settings
    fieldPath: data.CLUSTER_NAME
  targets:
  - select:
      kind: Kustomization
      name: secrets
    fieldPaths:
    - spec.path
    options:
      delimiter: /
      index: 2
