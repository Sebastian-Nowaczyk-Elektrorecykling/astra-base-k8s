# Prefer generating this file from the chosen profile:
# bash scripts/configure-cluster.sh --export laptops > local/cluster.env
CLUSTER_NAME=laptops
INTERNAL_DOMAIN=internal
# Copy to local/cluster.env on each machine. This file contains NO credentials.
# Keep the controller/API address stable in your router. Use wired Ethernet and reliable SSDs.
API_HOST=192.168.2.153
POD_CIDR=10.42.0.0/16
SERVICE_CIDR=10.43.0.0/16
CLUSTER_DNS=10.43.0.10
# Initially k8s1's address; before HA change to a stable external TCP load balancer.
# bootstrap-cilium.sh copies the shared bootstrap network values into the GitOps settings.
# For later changes run: bash scripts/configure-cluster.sh local/cluster.env
# Commit and push the selected clusters/NAME/settings.yaml; Flux cannot read this ignored local file.
