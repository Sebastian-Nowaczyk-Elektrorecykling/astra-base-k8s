; Explicit origins/TTLs avoid dollar directives being interpreted by Flux substitution.
${INTERNAL_DOMAIN}. 60 IN SOA dns.admin.${INTERNAL_DOMAIN}. hostmaster.${INTERNAL_DOMAIN}. (1 3600 600 86400 60)
${INTERNAL_DOMAIN}. 60 IN NS dns.admin.${INTERNAL_DOMAIN}.
dns.admin.${INTERNAL_DOMAIN}. 60 IN A ${DNS_IP}
hosts.${INTERNAL_DOMAIN}. 60 IN NS dns.admin.${INTERNAL_DOMAIN}.
*.${INTERNAL_DOMAIN}. 60 IN A ${EDGE_IP}
*.admin.${INTERNAL_DOMAIN}. 60 IN A ${EDGE_IP}
*.test.${INTERNAL_DOMAIN}. 60 IN A ${EDGE_IP}
*.staging.${INTERNAL_DOMAIN}. 60 IN A ${EDGE_IP}
