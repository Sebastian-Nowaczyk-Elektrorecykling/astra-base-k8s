; Explicit origins/TTLs avoid dollar directives being interpreted by Flux substitution.
internal. 60 IN SOA dns.admin.internal. hostmaster.internal. (1 3600 600 86400 60)
internal. 60 IN NS dns.admin.internal.
dns.admin.internal. 60 IN A ${DNS_IP}
hosts.internal. 60 IN NS dns.admin.internal.
*.internal. 60 IN A ${EDGE_IP}
*.admin.internal. 60 IN A ${EDGE_IP}
*.test.internal. 60 IN A ${EDGE_IP}
*.staging.internal. 60 IN A ${EDGE_IP}
